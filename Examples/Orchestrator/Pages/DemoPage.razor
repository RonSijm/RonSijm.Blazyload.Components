@page "/{Demo?}"

<main data-testid="demo-outlet">
    @switch (Demo?.ToLowerInvariant())
    {
        case null:
            <PageTitle>Blazyload demo orchestrator</PageTitle>
            <section class="orchestrator-intro">
                <h1>This demo orchestrator is a demo in and of itself. It uses one Blazor runtime.</h1>
                <p>Three demos supply their own entry components. This host loads the one you choose, without opening another Blazor application.</p>
                <div class="orchestrator-choices">
                    <article>
                        <h2>Simple: Burger and Pizza</h2>
                        <p>Composition with as few changes and dependencies as possible. Component names, parameters and callbacks. No source generator.</p>
                        <code>&lt;BlazyComponent Name="burger.editor" /&gt;</code>
                        <a href="Simple/" data-testid="open-simple">Open Simple demo</a>
                    </article>
                    <article>
                        <h2>Fluxor: a complete lazy feature</h2>
                        <p>An intentionally over-engineered tech demo: lazy features, state-aware layouts, composed ViewModels, lifecycle/browser effects and public actions. Imagine this screen is 10% of a larger application.</p>
                        <code>&lt;BlazyComponent Name="fluxor.bobsburgers.dashboard" /&gt;</code>
                        <a href="Fluxor/" data-testid="open-fluxor">Open Fluxor demo</a>
                    </article>
                    <article>
                        <h2>Extensive: Bob's Burgers and Wonder Wharf</h2>
                        <p>A technical sales-style page with visible consumer and producer code, generated contracts, services, assets and loading steps.</p>
                        <code>&lt;BlazyComponent Name="bobsburgers.dashboard" /&gt;</code>
                        <a href="Extensive/" data-testid="open-extensive">Open Extensive demo</a>
                    </article>
                </div>
                <section class="orchestrator-explanation" data-testid="orchestrator-explanation">
                    <h2>How this page orchestrates the three demos</h2>
                    <p>The shared <code>App.razor</code> owns the menu and Blazor router. Choosing a demo changes the route inside this running app; it does not open another host, iframe or WebAssembly runtime.</p>
                    <h3>1. Navigate inside the shared application</h3>
                    <p>These are excerpts from the real host. The navigation links select a route, and <code>RouteView</code> displays the page matched by that route.</p>
                    <pre class="orchestrator-code" data-testid="orchestrator-router-code"><code>@RouterCode</code></pre>
                    <h3>2. Choose a demo's entry component by name</h3>
                    <p><code>DemoPage.razor</code> receives the route's <code>Demo</code> parameter and requests the corresponding entry component. This excerpt shows the three demo branches; the same page also handles this home screen and unknown demo names.</p>
                    <pre class="orchestrator-code" data-testid="orchestrator-routing-code"><code>@RoutingCode</code></pre>
                    <h3>3. Load that feature, not another application</h3>
                    <p><code>BlazyComponent</code> looks up the name in the generated <code>blazy-components.json</code> catalog. Blazyload downloads the required assembly and dependencies, runs its service-registration bootstrap, and Components renders the entry component here. The host's project references publish the features; its lazy-load settings keep their implementations out of startup downloads.</p>
                    <p>The host does not reference Burger or Bob's Burgers implementation types in this Razor page. Once an entry is displayed, that demo can request its own Pizza or Wonder Wharf components through the same loading services. Switching demos replaces the displayed UI, not the shared application.</p>
                </section>
                <h2>Watch what gets loaded</h2>
                <p>Open DevTools (F12), select <strong>Network</strong>, disable caching and reload. No demo implementation is downloaded yet. Choose a demo, then use its button to load Pizza or Wonder Wharf.</p>
                <p>Switch demos using the navigation above. Blazor stays running; already-loaded assemblies aren't downloaded again. Component-local fields reset with new component instances. The Fluxor demo's shared store state stays until you refresh the browser.</p>
                <p>These .NET 10 assemblies are served as <code>.wasm</code> files, not <code>.dll</code> files. This host also defers each demo's model contracts; scoped styles can load at startup.</p>
                <p><a href="https://github.com/RonSijm/RonSijm.Blazyload.Components/tree/main/Examples">Read the source and setup</a>.</p>
            </section>
            break;
        case "simple":
            <PageTitle>Simple demo - Blazyload</PageTitle>
            <section class="orchestrator-simple">
                <BlazyComponent Name="burger.editor" />
            </section>
            break;
        case "extensive":
            <PageTitle>Extensive demo - Blazyload</PageTitle>
            <BlazyComponent Name="bobsburgers.dashboard" />
            break;
        case "fluxor":
            <PageTitle>Fluxor demo - Blazyload</PageTitle>
            <BlazyComponent Name="fluxor.bobsburgers.dashboard" />
            break;
        default:
            <PageTitle>Demo not found - Blazyload</PageTitle>
            <section class="orchestrator-intro">
                <h1>Demo not found</h1>
                <p>Choose Simple, Extensive or Fluxor above.</p>
            </section>
            break;
    }
</main>

@code {
    private const string RouterCode = """
        <NavLink href="Simple/">Simple</NavLink>
        <NavLink href="Extensive/">Extensive</NavLink>
        <NavLink href="Fluxor/">Fluxor</NavLink>

        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <RouteView RouteData="@routeData" />
            </Found>
        </Router>
        """;
    private const string RoutingCode = """
        @page "/{Demo?}"

        @switch (Demo?.ToLowerInvariant())
        {
            case "simple":
                <BlazyComponent Name="burger.editor" />
                break;
            case "extensive":
                <BlazyComponent Name="bobsburgers.dashboard" />
                break;
            case "fluxor":
                <BlazyComponent Name="fluxor.bobsburgers.dashboard" />
                break;
        }

        @code {
            [Parameter] public string? Demo { get; set; }
        }
        """;
    [Parameter]
    public string? Demo { get; set; }
}

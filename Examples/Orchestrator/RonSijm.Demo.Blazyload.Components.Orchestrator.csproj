<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <BlazyComponentsGenerateManifest>true</BlazyComponentsGenerateManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Fluxor\Shared\*.cs" Link="Diagnostics\%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.*" PrivateAssets="all" />
    <PackageReference Include="Fluxor.Blazor.Web.ReduxDevTools" Version="6.11.0" />
    <PackageReference Include="RonSijm.Blazyload.Fluxor" Version="2.0.2" />
    <ProjectReference Include="..\..\src\RonSijm.Blazyload.Components\RonSijm.Blazyload.Components.csproj" />
    <ProjectReference Include="..\Simple\RonSijm.Demo.Blazyload.Components.Burger\RonSijm.Demo.Blazyload.Components.Burger.csproj" />
    <ProjectReference Include="..\Simple\RonSijm.Demo.Blazyload.Components.Pizza\RonSijm.Demo.Blazyload.Components.Pizza.csproj" />
    <ProjectReference Include="..\Extensive\RonSijm.Demo.BobsBurgers\RonSijm.Demo.BobsBurgers.csproj" />
    <ProjectReference Include="..\Extensive\RonSijm.Demo.WonderWharf\RonSijm.Demo.WonderWharf.csproj" />
    <BlazyComponentContractReference Include="..\Extensive\RonSijm.Demo.WonderWharf\RonSijm.Demo.WonderWharf.csproj" />
    <ProjectReference Include="..\Fluxor\RonSijm.Demo.Fluxor.BobsBurgers\RonSijm.Demo.Fluxor.BobsBurgers.csproj" />
    <ProjectReference Include="..\Fluxor\RonSijm.Demo.Fluxor.WonderWharf\RonSijm.Demo.Fluxor.WonderWharf.csproj" />
    <ProjectReference Include="..\Fluxor\RonSijm.Demo.Fluxor.WonderWharf.Publications\RonSijm.Demo.Fluxor.WonderWharf.Publications.csproj" />
    <BlazyComponentContractReference Include="..\Fluxor\RonSijm.Demo.Fluxor.WonderWharf\RonSijm.Demo.Fluxor.WonderWharf.csproj" />
    <BlazorWebAssemblyLazyLoad Include="RonSijm.Demo.Blazyload.Components.Burger.wasm" />
    <BlazorWebAssemblyLazyLoad Include="RonSijm.Demo.Blazyload.Components.Pizza.wasm" />
    <BlazorWebAssemblyLazyLoad Include="RonSijm.Demo.Blazyload.Components.Pizza.Contracts.wasm" />
    <BlazorWebAssemblyLazyLoad Include="RonSijm.Demo.Blazyload.Components.Pizza.Services.wasm" />
    <BlazorWebAssemblyLazyLoad Include="RonSijm.Demo.BobsBurgers.wasm" />
    <BlazorWebAssemblyLazyLoad Include="RonSijm.Demo.WonderWharf.wasm" />
    <BlazorWebAssemblyLazyLoad Include="RonSijm.Demo.WonderWharf.Contracts.wasm" />
    <BlazorWebAssemblyLazyLoad Include="RonSijm.Demo.WonderWharf.Services.wasm" />
    <BlazorWebAssemblyLazyLoad Include="RonSijm.Demo.Fluxor.BobsBurgers.wasm" />
    <BlazorWebAssemblyLazyLoad Include="RonSijm.Demo.Fluxor.WonderWharf.wasm" />
    <BlazorWebAssemblyLazyLoad Include="RonSijm.Demo.Fluxor.WonderWharf.Publications.wasm" />
    <BlazorWebAssemblyLazyLoad Include="RonSijm.Demo.Fluxor.WonderWharf.Contracts.wasm" />
    <BlazorWebAssemblyLazyLoad Include="RonSijm.Fluxor.Blazor.Web.Extensions.wasm" />
    <BlazorWebAssemblyLazyLoad Include="System.Net.Http.Json.wasm" />
    <TrimmerRootAssembly Include="RonSijm.Demo.Fluxor.BobsBurgers" />
    <TrimmerRootAssembly Include="RonSijm.Demo.Fluxor.WonderWharf" />
    <TrimmerRootAssembly Include="RonSijm.Demo.Fluxor.WonderWharf.Publications" />
    <TrimmerRootAssembly Include="RonSijm.Blazyload.Fluxor" />
  </ItemGroup>
  <Target Name="ConfigureDemoPublication" AfterTargets="Publish">
    <PropertyGroup>
      <_DemoBaseHref>/</_DemoBaseHref>
      <_DemoBaseHref Condition="'$(GHPages)' == 'true'">/RonSijm.Blazyload.Components/</_DemoBaseHref>
    </PropertyGroup>
    <ReadLinesFromFile File="$(PublishDir)wwwroot\index.html">
      <Output TaskParameter="Lines" ItemName="_GitHubPagesIndexLines" />
    </ReadLinesFromFile>
    <WriteLinesToFile File="$(PublishDir)wwwroot\index.html" Lines="@(_GitHubPagesIndexLines->Replace('&lt;base href=&quot;/RonSijm.Blazyload.Components/&quot; /&gt;', '&lt;base href=&quot;/&quot; /&gt;')->Replace('&lt;base href=&quot;/&quot; /&gt;', '&lt;base href=&quot;$(_DemoBaseHref)&quot; /&gt;'))" Overwrite="true" Encoding="UTF-8" />
    <Touch Files="$(PublishDir)wwwroot\.nojekyll" AlwaysCreate="true" Condition="'$(GHPages)' == 'true'" />
    <ItemGroup>
      <_DemoRoute Include="Simple;Extensive;Fluxor" />
    </ItemGroup>
    <Copy SourceFiles="$(PublishDir)wwwroot\index.html" DestinationFolder="$(PublishDir)wwwroot\%(_DemoRoute.Identity)" />
  </Target>
</Project>
